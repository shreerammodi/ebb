{
    "name": "debate-flow",
    "version": "1.4.2",
    "private": true,
    "license": "MPL-2.0",
    "scripts": {
        "dev": "next dev -p 1280",
        "build": "next build",
        "test": "vitest run",
        "test:watch": "vitest",
        "bench": "BENCH_STRICT=1 vitest run test/lib/collab/perf.bench.test.ts",
        "lint": "eslint .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "tauri": "tauri",
        "desktop:dev": "tauri dev",
        "desktop:build": "tauri build",
        "desktop:build:bin": "tauri build --config src-tauri/tauri.standalone.conf.json --no-bundle",
        "desktop:build:macos": "tauri build --config src-tauri/tauri.standalone.conf.json --bundles app",
        "desktop:build:macos-universal": "tauri build --config src-tauri/tauri.standalone.conf.json --bundles app --target universal-apple-darwin",
        "desktop:build:linux": "tauri build --config src-tauri/tauri.standalone.conf.json --bundles appimage"
    },
    "dependencies": {
